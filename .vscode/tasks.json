{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VS2010: Build WinDbgLiteWin32UI (Debug|Win32)",
      "type": "shell",
      "command": "${workspaceFolder}\\BuildVS2010\\build.bat",
      "args": [
        "Debug",
        "Win32",
        "v100",
        "WinDbgLiteWin32UI"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
