#include <windows.h>
#include "McpServerResource.h"

#ifndef WDBL_AGENT_EMBEDDED
1 ICON "McpServer.ico"
#endif

IDD_MODEL_ADVANCED DIALOGEX 0, 0, 340, 352
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced model settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Max output tokens", -1, 12, 16, 94, 14
    EDITTEXT IDC_ADV_TOKENS, 112, 13, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "0 uses provider default", -1, 209, 16, 121, 14
    LTEXT "Model timeout (sec)", -1, 12, 42, 94, 14
    EDITTEXT IDC_ADV_TIMEOUT, 112, 39, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Temperature", -1, 12, 68, 94, 14
    EDITTEXT IDC_ADV_TEMPERATURE, 112, 65, 90, 16, ES_AUTOHSCROLL
    LTEXT "Blank uses default", -1, 209, 68, 121, 14
    LTEXT "Top-p", -1, 12, 94, 94, 14
    EDITTEXT IDC_ADV_TOP_P, 112, 91, 90, 16, ES_AUTOHSCROLL
    LTEXT "Blank uses default", -1, 209, 94, 121, 14
    LTEXT "Tool choice", -1, 12, 120, 94, 14
    COMBOBOX IDC_ADV_TOOL_CHOICE, 112, 117, 90, 56, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Chat rounds", -1, 12, 146, 94, 14
    EDITTEXT IDC_ADV_TOOL_ROUNDS, 112, 143, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Task rounds", -1, 12, 172, 94, 14
    EDITTEXT IDC_ADV_TASK_ROUNDS, 112, 169, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "0 = Unlimited", -1, 209, 172, 121, 14
    LTEXT "Total timeout (sec)", -1, 12, 198, 94, 14
    EDITTEXT IDC_ADV_TASK_TIMEOUT, 112, 195, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "0 = Unlimited", -1, 209, 198, 121, 14
    LTEXT "Round warning", -1, 12, 224, 94, 14
    EDITTEXT IDC_ADV_ROUND_WARNING, 112, 221, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Time warning (sec)", -1, 12, 250, 94, 14
    EDITTEXT IDC_ADV_TIME_WARNING, 112, 247, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "History messages", -1, 12, 276, 94, 14
    EDITTEXT IDC_ADV_HISTORY, 112, 273, 90, 16, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "Stream replies", IDC_ADV_STREAM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 303, 150, 16
    DEFPUSHBUTTON "Save", IDOK, 209, 324, 57, 18
    PUSHBUTTON "Cancel", IDCANCEL, 273, 324, 57, 18
END

IDD_AGENT_MODELS DIALOGEX 0, 0, 420, 302
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Multi-model agent"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Auto route", IDC_AGENT_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 120, 16
    CONTROL "Failover", IDC_AGENT_FAILOVER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 146, 12, 120, 16
    CONTROL "Review", IDC_AGENT_REVIEW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 280, 12, 120, 16
    LTEXT "Model slot", -1, 12, 43, 74, 14
    COMBOBOX IDC_AGENT_PROFILE, 92, 40, 150, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Enabled", IDC_AGENT_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 252, 40, 72, 16
    CONTROL "Reviewer", IDC_AGENT_REVIEWER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 330, 40, 78, 16
    LTEXT "Provider", -1, 12, 72, 74, 14
    COMBOBOX IDC_AGENT_PROVIDER, 92, 69, 316, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "API URL", -1, 12, 101, 74, 14
    EDITTEXT IDC_AGENT_URL, 92, 98, 316, 16, ES_AUTOHSCROLL
    LTEXT "Model", -1, 12, 130, 74, 14
    EDITTEXT IDC_AGENT_NAME, 92, 127, 316, 16, ES_AUTOHSCROLL
    LTEXT "API key", -1, 12, 159, 74, 14
    EDITTEXT IDC_AGENT_KEY, 92, 156, 316, 16, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Reasoning", -1, 12, 188, 74, 14
    COMBOBOX IDC_AGENT_EFFORT, 92, 185, 108, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Timeout (seconds)", -1, 218, 188, 116, 14
    EDITTEXT IDC_AGENT_TIMEOUT, 342, 185, 66, 16, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Route keywords", -1, 12, 217, 74, 14
    EDITTEXT IDC_AGENT_KEYWORDS, 92, 214, 316, 44, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "Save", IDOK, 286, 272, 57, 18
    PUSHBUTTON "Cancel", IDCANCEL, 351, 272, 57, 18
END

#ifndef WDBL_AGENT_EMBEDDED
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Z0BDbg\0"
            VALUE "FileDescription", "MCP Server\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "McpServer.exe\0"
            VALUE "OriginalFilename", "McpServer.exe\0"
            VALUE "ProductName", "Z0BDbg MCP Server\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
#endif
