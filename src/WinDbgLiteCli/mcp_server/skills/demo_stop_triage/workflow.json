{
  "name": "demo_stop_triage",
  "description": "Collect stop state, threads, modules, breakpoints, registers, and stack frames for a paused debuggee.",
  "risk": "read-only",
  "readOnly": true,
  "stopOnError": false,
  "autoTriggers": [
    "debuggee paused",
    "breakpoint hit",
    "exception stop",
    "crash triage"
  ],
  "parameters": {
    "scenario": {
      "type": "string",
      "default": "stop_triage"
    },
    "threadIndex": {
      "type": "integer",
      "default": 0
    },
    "maxFrames": {
      "type": "integer",
      "default": 8
    }
  },
  "parameterDefaults": {
    "scenario": "stop_triage",
    "threadIndex": 0,
    "maxFrames": 8
  },
  "steps": [
    {
      "tool": "wdbl_stop_info",
      "request": {
        "cmd": "stop_info"
      }
    },
    {
      "tool": "wdbl_threads",
      "request": {
        "cmd": "threads"
      }
    },
    {
      "tool": "wdbl_modules",
      "request": {
        "cmd": "modules"
      }
    },
    {
      "tool": "wdbl_breakpoints",
      "request": {
        "cmd": "breakpoints"
      }
    },
    {
      "tool": "wdbl_registers",
      "request": {
        "cmd": "registers",
        "index": "$threadIndex"
      }
    },
    {
      "tool": "wdbl_stack",
      "request": {
        "cmd": "stack",
        "threadIndex": "$threadIndex",
        "maxFrames": "$maxFrames"
      }
    }
  ]
}
